# Build artefacts and downloaded artefacts that should not travel via git.

# CLI binary cross-built by `task build`.
bin/

# Generated ISOs and the OVMF/EDK2 vars store snapshot.
*.iso
*.img
.ovmf_vars*.fd

# cloud-init NoCloud seed ISO generated by `task cidata`.
cidata.iso

# Distribution payload caches populated by `task push:alpine` /
# `task push:debian` / `task fetch:debian:cloud` / `task label:debian:cloud`.
.alpine-cache/
.debian-cache/

# Go test outputs.
*.test
coverage.out
coverage.html
cover.out

# Taskfile run-state.
.task/
