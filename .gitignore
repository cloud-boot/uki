# Build artefacts and downloaded artefacts that should not travel via git.

# CLI binary cross-built by `task build`.
bin/

# Generated ISOs and the OVMF/EDK2 vars store snapshot.
*.iso
*.img
.ovmf_vars*.fd

# cloud-init NoCloud seed ISO generated by `task cidata`.
cidata.iso

# Distribution payload caches populated by `task push:alpine` /
# `task push:debian` / `task fetch:debian:cloud` / `task label:debian:cloud`
# / `task push:debian-live` and the corresponding sibling distros.
.alpine-cache/
.alma-cache/
.debian-cache/
.debian-live-cache/
.fedora-cache/
.nixos-cache/
.suse-cache/
.ubuntu-cache/

# Stray host-built CLI binary if the operator drops one at the repo root
# (rare — `task build` puts it under bin/ by default, see above).
/cloud-boot

# Stray intermediate initramfs cpio if a build was interrupted before
# /tmp cleanup ran.
/initrd.cpio

# Go test outputs.
*.test
coverage.out
coverage.html
cover.out

# Taskfile run-state.
.task/
